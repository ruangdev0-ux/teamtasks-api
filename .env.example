# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.
NODE_ENV=development
PORT=3333

# PostgreSQL (o docker-compose.yml sobe um banco com estes dados)
DATABASE_URL=postgresql://teamtasks:teamtasks@localhost:5432/teamtasks

# Gere um segredo longo e aleatório, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h

# Custo do bcrypt (10 a 12 é o recomendado; os testes usam 4 para ficar rápidos)
BCRYPT_ROUNDS=10
